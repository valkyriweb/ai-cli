# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.11@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS build
WORKDIR /src
COPY . .
RUN bun install --frozen-lockfile --ignore-scripts
RUN cd packages/ai-cli && bun run typecheck && bun run build

FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d
ARG SOURCE_REVISION
ARG VERSION=0.4.3
LABEL org.opencontainers.image.source="https://github.com/valkyriweb/ai-cli" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN test -n "$SOURCE_REVISION" && mkdir -p /opt/ai-cli/dist /opt/ai-cli/skill
COPY --from=build /src/packages/ai-cli/dist/ /opt/ai-cli/dist/
COPY packages/ai-cli/LICENSE /opt/ai-cli/LICENSE
COPY skills/ai-cli/ /opt/ai-cli/skill/
COPY packages/ai-cli/scripts/seed-runtime.sh /usr/local/bin/seed-ai-cli
RUN printf '%s\n' "$SOURCE_REVISION" > /opt/ai-cli/SOURCE_REVISION \
    && printf '%s\n' "$VERSION" > /opt/ai-cli/VERSION \
    && chmod 0555 /usr/local/bin/seed-ai-cli /opt/ai-cli/dist/index.js \
    && chmod -R a-w /opt/ai-cli
ENTRYPOINT ["/usr/local/bin/seed-ai-cli"]
